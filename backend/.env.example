PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=insurance_crm
DB_USER=root
DB_PASSWORD=your_mysql_password

# Must be at least 32 characters — the server refuses to start otherwise.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long_change_this
JWT_EXPIRES_IN=7d

GMAIL_USER=your@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

WATI_API_URL=https://live-mt-server.wati.io/YOUR_INSTANCE
WATI_API_TOKEN=your_wati_bearer_token

FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Number of reverse proxies in front of the app (affects rate-limit client IPs).
# 1 is correct for a single Nginx fronting Node, as in the README deployment.
TRUST_PROXY=1

# Max POSTs to /api/auth per IP per 15 minutes. Defaults to 30.
# Raise it only when running the integration suite (npm test).
RATE_LIMIT_AUTH_MAX=30

# Field-level encryption key for PAN/Aadhaar numbers and provider API
# credentials. Required — the server refuses to start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this makes existing encrypted values unreadable; re-encrypt first.
ENCRYPTION_KEY=

# Optional. Error-tracking DSN (e.g. Sentry). Errors log locally when unset.
ERROR_TRACKING_DSN=

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
